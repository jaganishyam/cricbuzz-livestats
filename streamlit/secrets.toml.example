# Copy this file to .streamlit/secrets.toml and fill in real values.
# This is the recommended way to store secrets when deploying to
# Streamlit Community Cloud (Settings -> Secrets in the app dashboard
# uses this exact TOML format). Never commit the real secrets.toml.

[api]
CRICBUZZ_API_KEY = ""

[database]
DB_ENGINE = "sqlite"
DB_PATH = "data/cricbuzz.db"

# Only needed if DB_ENGINE is "postgresql" or "mysql"
# DB_HOST = "localhost"
# DB_PORT = "5432"
# DB_NAME = "cricbuzz"
# DB_USER = ""
# DB_PASSWORD = ""
